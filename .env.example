# =============================================================================
# Merchant Face Verification Demo — copy to .env.local and fill in your values
# =============================================================================

# Session signing (change this in any shared environment)
SESSION_SECRET=mallax-vision-demo-secret-change-me

# -----------------------------------------------------------------------------
# FACE COMPARISON API
# -----------------------------------------------------------------------------
# Keep true to skip the live API. Set to false to call /compare-face.
FACE_COMPARISON_USE_MOCK=false
# When mock is enabled, true simulates a successful match; false simulates failure.
FACE_COMPARISON_MOCK_MATCH=true

# Base URL of the face API. The app POSTs JSON to {this}/compare-face
FACE_COMPARISON_API_URL=https://node-face-api.abiahighcourt.org/api
FACE_COMPARISON_API_KEY=
FACE_COMPARISON_API_KEY_HEADER=Authorization
FACE_COMPARISON_API_KEY_PREFIX=Bearer 

# json (data-URL fields) or multipart (file upload)
FACE_COMPARISON_REQUEST_FORMAT=json

# Request field names expected by POST /compare-face
FACE_COMPARISON_CAPTURED_IMAGE_FIELD=capturedImage
FACE_COMPARISON_REFERENCE_IMAGE_FIELD=referenceImage

# Optional extra JSON merged into the request body / form fields
# Example: {"threshold":0.7,"model":"default"}
FACE_COMPARISON_EXTRA_JSON=

# Enrolled merchant photo used as the reference face
FACE_COMPARISON_REFERENCE_IMAGE_PATH=public/demo/reference-face.jpg
FACE_COMPARISON_REFERENCE_IMAGE_URL=
# If true, the reference field is sent as a URL string instead of image bytes
FACE_COMPARISON_SEND_REFERENCE_AS_URL=false

# Response mapping (dot-paths are supported, e.g. data.similarity)
FACE_COMPARISON_RESPONSE_SCORE_PATH=score
FACE_COMPARISON_RESPONSE_MATCH_PATH=match
FACE_COMPARISON_MATCH_THRESHOLD=0.7
